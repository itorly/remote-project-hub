# --- Database (used by docker-compose for Postgres) ---
POSTGRES_DB=remote_project_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- App (used by Spring Boot) ---
# If you run the app on your host machine (recommended for dev), keep DB_URL as localhost.
DB_URL=jdbc:postgresql://localhost:5432/remote_project_hub
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server port
PORT=8080

# JWT (for dev only; in prod, set a strong secret)
# Must be at least 32 bytes for HS256.
JWT_SECRET=replace-with-a-long-secret-key-at-least-32-bytes
JWT_VALIDITY_MS=86400000
REFRESH_TOKEN_VALIDITY_MS=1209600000
